<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_rviz_panel</name>
  <version>0.0.1</version>
  <description>Docked RViz panel with G1 control buttons (gestures, homing, head LED). Publishes a command string on /g1_panel_cmd that unitree_control dispatches.</description>
  <maintainer email="tsaisplus0x0@gmail.com">Yuxin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>
  <depend>qtbase5-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
