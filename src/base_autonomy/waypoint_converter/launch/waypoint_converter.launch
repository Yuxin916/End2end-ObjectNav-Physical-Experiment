<launch>

  <arg name="world_name" default="unity"/>

  <node pkg="waypoint_converter" exec="waypointConverter" name="waypointConverter" output="screen">
    <param name="trav_area_file_dir" value="$(find-pkg-prefix vehicle_simulator)/mesh/$(var world_name)/traversable_area.ply" />
    <param name="boundary_file_dir" value="$(find-pkg-prefix vehicle_simulator)/mesh/$(var world_name)/boundary.ply" />
    <param name="waypointXYRadius" value="0.3" />
    <param name="waypointProjDis" value="0.5" />
    <param name="twoWayHeading" value="false" />
    <param name="frameRate" value="10.0" />
    <param name="useTerrainAnalysis" value="true" />
    <param name="terrainVoxelSize" value="0.05" />
    <param name="obstacleHeightThre" value="0.05" />
    <param name="obstacleDisThre" value="0.75" />
    <param name="checkTravArea" value="true" />
    <param name="waypointTravAdj" value="true" />
    <param name="adjDisThre" value="5.0" />
    <param name="searchDisThre" value="5.0" />
    <param name="vehicleDisWeight" value="0.5" />
    <param name="travDisThre" value="0.1" />
    <param name="extDis" value="0.0" />
    <param name="yawConfig" value="-1" /> <!-- -1: reach waypoint and stop, 0: waypoint yaw, 1: yaw to waypoint, 2: yaw sideway to waypoint -->
    <param name="speed" value="0.875" />
    <param name="sendSpeed" value="true" />
    <param name="sendBoundary" value="false" />
  </node>

</launch>
