# Fast incremental build: layers the unitree_sdk2 (DDS) control stack on top of
# the already-built heavy-deps image (autonomy_stack:heavy = ROS Jazzy + Sophus
# /Ceres/GTSAM/Livox-SDK2). Avoids recompiling GTSAM on every iteration.
#
# docker/Dockerfile remains the canonical from-scratch build (same result).
FROM autonomy_stack:heavy

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Drop the legacy WebRTC venv (SDK backend doesn't need it).
RUN rm -rf /opt/uvenv

# cyclonedds 0.10.2 (required by unitree_sdk2_python), built from source.
RUN git clone --depth 1 --branch 0.10.2 \
        https://github.com/eclipse-cyclonedds/cyclonedds /tmp/cyclonedds \
    && cmake -S /tmp/cyclonedds -B /tmp/cyclonedds/build \
        -DCMAKE_INSTALL_PREFIX=/opt/cyclonedds -DBUILD_IDLC=YES -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/cyclonedds/build --target install -j"$(nproc)" \
    && rm -rf /tmp/cyclonedds
ENV CYCLONEDDS_HOME=/opt/cyclonedds
ENV LD_LIBRARY_PATH=/opt/cyclonedds/lib:${LD_LIBRARY_PATH}

# numpy + cyclonedds python binding, then the latest SDK (--no-deps avoids
# pulling opencv-python; g1 loco only needs cyclonedds + numpy).
RUN pip install --no-cache-dir --break-system-packages cyclonedds==0.10.2 numpy \
    && git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2_python \
        /opt/unitree_sdk2_python \
    && pip install --no-cache-dir --break-system-packages --no-deps -e /opt/unitree_sdk2_python

# Extra ROS packages (kept in one late layer so the heavy steps above stay cached):
#   - foxglove-bridge: remote viz over WebSocket ws://<jetson>:8765 (README §2.5.3)
#   - rmw-cyclonedds-cpp: alternative ROS2 RMW. With ROS_DOMAIN_ID=1 below it
#     isolates the autonomy stack from the robot's ~100 domain-0 DDS participants,
#     which otherwise congest Fast DDS discovery and drop IMU/lidar frames -> SLAM
#     drift. (Borrowed from the will_nx branch's localization fix.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-foxglove-bridge \
      ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# WebRTC control backend (control_backend:=webrtc). The unitree_webrtc_ros node
# imports unitree_webrtc_connect, which drives the robot over an aiortc data
# channel. Unlike the sdk backend it adds NO participant to the robot's domain-0
# DDS, so it sidesteps the discovery-congestion SLAM drift. (Replaces the old
# /opt/uvenv venv removed above -- installed into system python so the node's
# `#!/usr/bin/env python3` shebang picks it up with no venv activation.)
#   --ignore-installed: install the dep tree into /usr/local (shadows the apt
#   copies on sys.path) so pip never tries to uninstall the RECORD-less debian
#   numpy/cryptography and abort. numpy pinned to the ROS-compatible 1.26.4.
RUN apt-get update && apt-get install -y --no-install-recommends \
      portaudio19-dev libsrtp2-1 libopus0 libvpx-dev libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages --ignore-installed \
       unitree_webrtc_connect==2.1.2 PyYAML numpy==1.26.4 opencv-python==4.10.0.84

# Isolate ROS2 traffic from the robot's native DDS (domain 0) via ROS_DOMAIN_ID=1.
# RMW = Fast DDS (default). cyclonedds was tried (will_nx) but CAUSED LIO drift on
# the Jetson (drops/delays 200Hz IMU + lidar under load); owner commit d92956f also
# removed it to fix localization. So: Fast DDS + domain isolation. (rmw-cyclonedds-cpp
# is still installed but only the unitree_sdk2 SDK side uses cyclonedds, not ROS.)
# Applies to every shell in the container (launch, `docker exec`, foxglove).
# Does NOT affect unitree_sdk2 control: it talks raw cyclonedds on its own domain
# via ChannelFactoryInitialize(0, iface), independent of these ROS2 env vars.
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
